# .env 配置文件模板。
# 仅供开发机本地 Python / PowerShell 辅助脚本使用；Android App 编译和运行时不会读取此文件。
# 请复制为项目根目录 .env 后填写真实值；.env 不得提交、push、粘贴到日志、Issue、PR 或聊天中。
# App 内用户 BYOK Key 仍通过应用自己的密钥管理界面配置，与这里的开发期 Key 无关。

# -----------------------------------------------------------------------------
# 通用 / 旧辅助脚本兼容
# -----------------------------------------------------------------------------
# 部分 workspace/tools 下的旧辅助脚本仍会读取 GEMINI_API_KEY / GEMINI_API_KEYS。
# 若不使用这些脚本，可以保持占位值；不要把下面字段当作 Skill Knowledge 双 lane 配置。
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=[]

# -----------------------------------------------------------------------------
# Skill Knowledge + gemini-embedding-2 离线索引生成
# -----------------------------------------------------------------------------
# 当前生成器支持 1 / 2 / 4 路并发（默认 2）。
# - 2 路：Lane A 使用账号 A 的 10 个 Project；Lane B 使用账号 B 的 10 个 Project。
# - 4 路：通过 --concurrency 4 启用；生成器会自动把 A 的 10 个 Project 拆成 5+5，
#         把 B 的 10 个 Project 拆成 5+5。仍然只有一个 generate_index.py 进程。
# - 4 路请求会做轻微错峰，避免四个请求在同一瞬间起发。
#
# 每个变量必须对应一个不同 Project 的 API Key。
# 不要在 A/B 两组中重复使用同一个 Key。
# 生成器只读取环境变量，不会打印完整 Key。
# 本地执行时应将 .env 中这些值安全加载到当前进程环境后再运行 generate_index.py。
#
# Lane A：账号 A / 10 个 Project
GEMINI_API_KEY_A_1=your_account_a_project_01_key_here
GEMINI_API_KEY_A_2=your_account_a_project_02_key_here
GEMINI_API_KEY_A_3=your_account_a_project_03_key_here
GEMINI_API_KEY_A_4=your_account_a_project_04_key_here
GEMINI_API_KEY_A_5=your_account_a_project_05_key_here
GEMINI_API_KEY_A_6=your_account_a_project_06_key_here
GEMINI_API_KEY_A_7=your_account_a_project_07_key_here
GEMINI_API_KEY_A_8=your_account_a_project_08_key_here
GEMINI_API_KEY_A_9=your_account_a_project_09_key_here
GEMINI_API_KEY_A_10=your_account_a_project_10_key_here

# Lane B：账号 B / 10 个 Project
GEMINI_API_KEY_B_1=your_account_b_project_01_key_here
GEMINI_API_KEY_B_2=your_account_b_project_02_key_here
GEMINI_API_KEY_B_3=your_account_b_project_03_key_here
GEMINI_API_KEY_B_4=your_account_b_project_04_key_here
GEMINI_API_KEY_B_5=your_account_b_project_05_key_here
GEMINI_API_KEY_B_6=your_account_b_project_06_key_here
GEMINI_API_KEY_B_7=your_account_b_project_07_key_here
GEMINI_API_KEY_B_8=your_account_b_project_08_key_here
GEMINI_API_KEY_B_9=your_account_b_project_09_key_here
GEMINI_API_KEY_B_10=your_account_b_project_10_key_here
